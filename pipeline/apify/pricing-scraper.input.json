{
  "_actor": "apify/website-content-crawler",
  "_purpose": "Crawl official LLM provider pricing pages (JS-heavy) into clean markdown for price extraction. Run from the Apify console or via API: POST https://api.apify.com/v2/acts/apify~website-content-crawler/run-sync-get-dataset-items?token=$APIFY_TOKEN",
  "startUrls": [
    { "url": "https://openai.com/api/pricing/" },
    { "url": "https://www.anthropic.com/pricing" },
    { "url": "https://ai.google.dev/pricing" },
    { "url": "https://nebius.com/prices-ai-studio" },
    { "url": "https://www.databricks.com/product/pricing/foundation-model-serving" },
    { "url": "https://www.together.ai/pricing" },
    { "url": "https://groq.com/pricing" },
    { "url": "https://fireworks.ai/pricing" },
    { "url": "https://mistral.ai/pricing" },
    { "url": "https://api-docs.deepseek.com/quick_start/pricing" },
    { "url": "https://x.ai/api" }
  ],
  "crawlerType": "playwright:adaptive",
  "maxCrawlDepth": 0,
  "maxCrawlPages": 15,
  "proxyConfiguration": { "useApifyProxy": true },
  "removeCookieWarnings": true,
  "saveMarkdown": true,
  "htmlTransformer": "readableText"
}
